@code {
    private void GoBack() => Nav.NavigateTo("/home");

    public class GameRound
    {
        public string TargetWord { get; set; } = "";
        public string[] Emojis { get; set; } = new string[0];
        public int Difficulty { get; set; }
    }

    private readonly List<GameRound> allRounds = new()
    {
        new GameRound { TargetWord = "RAPI", Emojis = new[] { "🗜️", "📖", "⬛", "🖊️" }, Difficulty = 1 },
        new GameRound { TargetWord = "BUKU", Emojis = new[] { "✏️", "🖌️", "🪑", "🖌️" }, Difficulty = 1 },
        new GameRound { TargetWord = "GURU", Emojis = new[] { "🎒", "🖌️", "🗜️", "🖌️" }, Difficulty = 2 },
        new GameRound { TargetWord = "PURA", Emojis = new[] { "⬛", "🖌️", "🗜️", "📖" }, Difficulty = 2 },
        new GameRound { TargetWord = "BARI", Emojis = new[] { "✏️", "📖", "🗜️", "🖊️" }, Difficulty = 3 }
    };

    private List<GameRound> roundQueue = new();
    private int currentRoundIndex = 0;
    private int score = 0;
    private char[] userAnswers = Array.Empty<char>();
    private char draggedLetter = '\0';
    private char selectedLetter = '\0';
    private bool isWinnerThisRound = false;
    private bool gameFinished = false;
    private int timeRemaining;
    private int roundDuration = 45;
    private int hintCount = 0;
    private bool showConfetti = false;
    private string message = "Tap a letter to begin!";
    private readonly char[] availableLetters = new[] { 'A', 'B', 'G', 'I', 'K', 'P', 'R', 'U' };
    private readonly Dictionary<char, int> letterUsageCounts = new();
    private readonly Stack<int> placementHistory = new();
    private Timer? roundTimer;
    private Timer? autoNextTimer;
    private int autoNextSecondsRemaining = 0;
    private readonly string[] confettiPieces = new[] { "🎉", "✨", "🎊", "🌟", "💫", "🎈", "🎉", "✨", "🎊", "🌟", "💥", "🎈", "✨", "🎉" };

    private GameRound CurrentRound => roundQueue[currentRoundIndex];

    private int ProgressPercent => (int)Math.Ceiling(100.0 * timeRemaining / roundDuration);

    private bool CanUseHint => !isWinnerThisRound && timeRemaining > 0 && hintCount < 2 && userAnswers.Any(c => c == '\0');

    private bool IsNextFillSlot(int index)
        => !isWinnerThisRound && !gameFinished && index == Array.FindIndex(userAnswers, c => c == '\0');

    protected override void OnInitialized()
    {
        InitializeRounds();
        StartRound();
    }

    private void InitializeRounds()
    {
        roundQueue = allRounds
            .OrderBy(r => r.Difficulty)
            .ThenBy(r => r.TargetWord)
            .ToList();
    }

    private async Task PlaySound(string soundType)
    {
        try
        {
            await JS.InvokeVoidAsync("gameSounds.play", soundType);
        }
        catch
        {
            // Ignore audio failures in older browsers.
        }
    }

    private void StartRound()
    {
        isWinnerThisRound = false;
        selectedLetter = '\0';
        draggedLetter = '\0';
        hintCount = 0;
        message = "Tap a letter to begin!";
        ResetDropZones();
        timeRemaining = roundDuration;

        autoNextTimer?.Dispose();
        autoNextSecondsRemaining = 0;
        roundTimer?.Dispose();
        roundTimer = new Timer(_ => TickTimer(), null, 1000, 1000);
    }

    private void TickTimer()
    {
        InvokeAsync(() =>
        {
            timeRemaining = Math.Max(0, timeRemaining - 1);
            if (timeRemaining <= 0 && !isWinnerThisRound)
            {
                message = "Time's up! Tap Next Word to continue.";
                isWinnerThisRound = true;
                _ = PlaySound("wrong");
            }
            StateHasChanged();
        });
    }

    private void ResetDropZones()
    {
        userAnswers = new char[CurrentRound.TargetWord.Length];
        for (int i = 0; i < userAnswers.Length; i++)
        {
            userAnswers[i] = '\0';
        }

        letterUsageCounts.Clear();
        placementHistory.Clear();
    }

    private void HandleDragStart(char letter)
    {
        if (RemainingLetterCount(letter) == 0)
        {
            return;
        }
        draggedLetter = letter;
        selectedLetter = letter;
    }

    private void SelectLetter(char letter)
    {
        if (RemainingLetterCount(letter) == 0 || isWinnerThisRound)
        {
            return;
        }

        selectedLetter = letter;
        PlaceInNextEmptySlot(letter);
    }

    private void PlaceInNextEmptySlot(char letter)
    {
        var nextEmptyIndex = Array.FindIndex(userAnswers, c => c == '\0');
        if (nextEmptyIndex < 0)
        {
            message = "All slots are filled!";
            return;
        }

        if (letter == CurrentRound.TargetWord[nextEmptyIndex])
        {
            PlaceLetter(letter, nextEmptyIndex);
            message = "Great choice!";
        }
        else
        {
            message = "Try another letter or drop the right one in the empty slot.";
            _ = PlaySound("wrong");
        }
    }

    private void HandleDrop(int index)
    {
        if (isWinnerThisRound) return;

        var letterToPlace = selectedLetter != '\0' ? selectedLetter : draggedLetter;
        if (letterToPlace == '\0')
        {
            message = "Pick a letter first.";
            return;
        }

        if (letterToPlace == CurrentRound.TargetWord[index])
        {
            PlaceLetter(letterToPlace, index);
            message = "Nice!";
        }
        else
        {
            message = "That letter doesn't belong here.";
            _ = PlaySound("wrong");
        }
    }

    private void PlaceLetter(char letter, int index)
    {
        if (userAnswers[index] != '\0')
        {
            return;
        }

        userAnswers[index] = letter;
        placementHistory.Push(index);
        IncrementLetterUsage(letter);
        selectedLetter = '\0';
        draggedLetter = '\0';
        _ = PlaySound("correct");
        CheckWinCondition();
    }

    private void IncrementLetterUsage(char letter)
    {
        letterUsageCounts[letter] = letterUsageCounts.TryGetValue(letter, out var count) ? count + 1 : 1;
    }

    private void DecrementLetterUsage(char letter)
    {
        if (!letterUsageCounts.TryGetValue(letter, out var count))
        {
            return;
        }
        if (count <= 1)
        {
            letterUsageCounts.Remove(letter);
            return;
        }
        letterUsageCounts[letter] = count - 1;
    }

    private int PlacedCount(char letter)
        => letterUsageCounts.TryGetValue(letter, out var count) ? count : 0;

    private int RequiredCount(char letter)
        => CurrentRound.TargetWord.Count(c => c == letter);

    private int RemainingLetterCount(char letter)
        => Math.Max(0, RequiredCount(letter) - PlacedCount(letter));

    private void CheckWinCondition()
    {
        var currentAnswer = new string(userAnswers);
        if (currentAnswer == CurrentRound.TargetWord)
        {
            isWinnerThisRound = true;
            score += 10;
            message = "You solved it!";
            _ = PlaySound("win");
            DisplayConfetti();
            ScheduleAutoNextRound();
        }
    }

    private void ScheduleAutoNextRound()
    {
        autoNextTimer?.Dispose();
        autoNextSecondsRemaining = 3;

        autoNextTimer = new Timer(_ =>
        {
            InvokeAsync(() =>
            {
                if (!isWinnerThisRound || gameFinished)
                {
                    autoNextTimer?.Dispose();
                    return;
                }

                autoNextSecondsRemaining--;

                if (autoNextSecondsRemaining <= 0)
                {
                    autoNextTimer?.Dispose();
                    NextRound();
                }
                StateHasChanged();
            });
        }, null, 1000, 1000);
    }

    private async void DisplayConfetti()
    {
        showConfetti = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(2000);
        showConfetti = false;
        await InvokeAsync(StateHasChanged);
    }

    private void Undo()
    {
        if (placementHistory.Count == 0)
        {
            message = "Nothing to undo yet.";
            return;
        }

        var index = placementHistory.Pop();
        var removedLetter = userAnswers[index];
        userAnswers[index] = '\0';
        DecrementLetterUsage(removedLetter);
        selectedLetter = '\0';
        message = "Undo successful.";
    }

    private void UseHint()
    {
        if (!CanUseHint)
        {
            return;
        }

        var nextEmptyIndex = Array.FindIndex(userAnswers, c => c == '\0');
        if (nextEmptyIndex < 0)
        {
            return;
        }

        var correctLetter = CurrentRound.TargetWord[nextEmptyIndex];
        PlaceLetter(correctLetter, nextEmptyIndex);
        hintCount++;
        message = "Hint used! One letter is filled in.";
        _ = PlaySound("hint");
    }

    private void NextRound()
    {
        autoNextTimer?.Dispose();
        autoNextSecondsRemaining = 0;

        if (currentRoundIndex + 1 >= roundQueue.Count)
        {
            gameFinished = true;
            roundTimer?.Dispose();
            return;
        }

        currentRoundIndex++;
        StartRound();
    }

    private void RestartGame()
    {
        score = 0;
        currentRoundIndex = 0;
        gameFinished = false;
        InitializeRounds();
        StartRound();
    }
}
