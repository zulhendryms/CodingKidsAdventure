    .confetti-piece:nth-child(6) { left: 74%; animation-delay: 0.12s; }
    .confetti-piece:nth-child(7) { left: 87%; animation-delay: 0.08s; }
    .confetti-piece:nth-child(8) { left: 16%; animation-delay: 0.22s; }
    .confetti-piece:nth-child(9) { left: 29%; animation-delay: 0.06s; }
