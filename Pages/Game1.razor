@page "/game1"
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="game-page">
    <div class="game-header">
        <button class="back-button" @onclick="GoBack">◀️ Back</button>
        <div class="score-box">⭐ Score: @score</div>
    </div>

    <div class="status-bar">
        <div class="timer">⏱️ @timeRemaining s left</div>
        <div class="progress-bar" aria-label="Round progress">
            <div class="progress-fill" style="width:@ProgressPercent%"></div>
        </div>
    </div>

    <div class="card code-key">
        <h3>🔑 CODE KEY</h3>
        <div class="code-grid">
            <span>📖=A</span>
            <span>✏️=B</span>
            <span>🎒=G</span>
            <span>🖊️=I</span>
            <span>🪑=K</span>
            <span>⬛=P</span>
            <span>🗜️=R</span>
            <span>🖌️=U</span>
        </div>
    </div>

    @if (!gameFinished)
    {
        <div class="clue-row">
            @foreach (var emoji in CurrentRound.Emojis)
            {
                <div class="clue-item">@emoji</div>
            }
        </div>

        <div class="drop-zone-row">
            @for (int i = 0; i < CurrentRound.TargetWord.Length; i++)
            {
                int index = i;
                <button class="@($"drop-slot {(IsNextFillSlot(index) ? "highlight" : "")}{(userAnswers[index] != '\0' ? " filled" : "")}")"
                        @ondragover:preventDefault
                        @ondrop="@(e => HandleDrop(index))"
                        @onclick="@( () => HandleDrop(index) )">
                    @(userAnswers[index] == '\0' ? "_" : userAnswers[index])
                </button>
            }
        </div>

        @if (selectedLetter != '\0')
        {
            <div class="selected-bubble">Selected: <strong>@selectedLetter</strong></div>
        }

        <div class="control-row">
            <button class="action-button" @onclick="Undo" disabled="@(placementHistory.Count == 0)">↩️ Undo</button>
            <button class="action-button hint-button" @onclick="UseHint" disabled="@(!CanUseHint)">💡 Hint (@hintCount/2)</button>
        </div>

        <div class="letter-grid">
            @foreach (var letter in availableLetters)
            {
                var remaining = RemainingLetterCount(letter);
                <button class="letter-tile @(remaining == 0 ? "used" : "") @(selectedLetter == letter ? "active" : "")"
                        disabled="@(remaining == 0)"
                        draggable="true"
                        @ondragstart="() => HandleDragStart(letter)"
                        @onclick="() => SelectLetter(letter)">
                    @letter
                    @if (remaining > 1)
                    {
                        <span class="letter-count">x@remaining</span>
                    }
                </button>
            }
        </div>

        <div class="message-row">
            <span class="message-text">@message</span>
        </div>

        @if (isWinnerThisRound)
        {
            <div class="celebrate-card">
                <h2>🎉 GREAT JOB! 🎉</h2>
                <p>Word complete: <strong>@CurrentRound.TargetWord</strong></p>
                <button class="next-button" @onclick="NextRound">Next Word ➡️</button>
                @if (autoNextSecondsRemaining > 0)
                {
                    <p class="auto-next-text">Auto advancing in @autoNextSecondsRemaining second@(autoNextSecondsRemaining == 1 ? "" : "s")...</p>
                }
            </div>
        }
    }
    else
    {
        <div class="game-over-card">
            <h1>🏆 YOU WIN! 🏆</h1>
            <p>You collected <strong>@score</strong> stars!</p>
            <button class="next-button" @onclick="RestartGame">Play Again 🔄</button>
        </div>
    }

    @if (showConfetti)
    {
        <div class="confetti-overlay">
            @foreach (var piece in confettiPieces)
            {
                <span class="confetti-piece">@piece</span>
            }
        </div>
    }
</div>

<style>
    .game-page {
        padding: 20px;
        font-family: "Segoe UI", system-ui, sans-serif;
        color: #2c3e50;
        max-width: 900px;
        margin: 0 auto;
