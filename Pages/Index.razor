@page "/"
@inject NavigationManager Nav

<div style="text-align: center; margin-top: 100px; font-family: sans-serif;">
    <h1 style="font-size: 50px; color: #FF5722;">🌟 Codi's Learning Adventure 🌟</h1>
    <p style="font-size: 24px; color: #555;">Let's learn to code!</p>

    <button @onclick="GoToHome" 
            style="font-size: 40px; padding: 20px 60px; background-color: #4CAF50; color: white; border: none; border-radius: 20px; cursor: pointer; margin-top: 50px; box-shadow: 0 8px 16px rgba(0,0,0,0.2);">
        ▶️ PLAY
    </button>
</div>

@code {
    private void GoToHome()
    {
        Nav.NavigateTo("/home");
    }
}